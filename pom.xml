<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>com.lynx</groupId>
  <artifactId>lynx-parent</artifactId>
  <version>0.1.0</version>
  <packaging>pom</packaging>

  <name>Lynx — Multi-Currency Ledger Engine</name>
  <description>Production-grade multi-currency ledger with 3-step saga orchestration, event-driven CQRS, and distributed tracing</description>
  <url>https://github.com/rajenthar/lynx</url>

  <!-- SHARED LIBRARIES (6 modules) + the 7 services that actually have
       real code today. Every other service under services/ (notification,
       reconciliation, reporting, audit, admin, kyc, reference-data, fee,
       settlement, scheduler, config, fraud-detection, limits) is still
       just an empty placeholder directory from early scaffolding — no
       pom.xml, nothing tracked by git — add it back here only once it
       actually has a real module in it. -->
  <modules>
    <!-- Foundation -->
    <module>shared/lynx-common</module>
    <module>shared/lynx-money</module>
    <module>shared/lynx-security</module>
    <module>shared/lynx-idempotency</module>
    <module>shared/lynx-events</module>
    <module>shared/lynx-telemetry</module>

    <!-- Edge -->
    <module>services/api-gateway</module>
    <module>services/auth-service</module>

    <!-- Orchestration -->
    <module>services/transaction-service</module>
    <module>services/saga-orchestrator</module>

    <!-- Core money services -->
    <module>services/ledger-service</module>
    <module>services/account-service</module>
    <module>services/fx-rate-service</module>
  </modules>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <maven.compiler.source>21</maven.compiler.source>
    <maven.compiler.target>21</maven.compiler.target>

    <!-- Dependencies -->
    <spring-boot.version>3.3.0</spring-boot.version>
    <!-- 2023.0.0 (this train's original release) only declares
         compatibility with Spring Boot 3.2.x — its own
         CompatibilityVerifier rejects startup against this project's
         Boot 3.3.0 otherwise (other-docs/14, api-gateway — the first
         real Spring Cloud consumer in this project). 2023.0.3 is the
         patch that added 3.3.x support to the SAME 2023.0.x release
         train, not a train upgrade. -->
    <spring-cloud.version>2023.0.3</spring-cloud.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <!-- Spring Boot BOM -->
      <dependency>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-dependencies</artifactId>
        <version>${spring-boot.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>

      <!-- Spring Cloud BOM -->
      <dependency>
        <groupId>org.springframework.cloud</groupId>
        <artifactId>spring-cloud-dependencies</artifactId>
        <version>${spring-cloud.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <!--
    Only TEST tooling is inherited by every module. Test-scope dependencies are
    NOT transitive, so they never leak onto a consumer's runtime classpath.

    Compile/runtime dependencies (Spring Boot starters, Jackson, etc.) are declared
    per-module by whichever module actually needs them. This keeps the shared value
    libraries (lynx-common, lynx-money) minimal: a service importing Money must not
    be forced to inherit the whole Spring Framework. Versions for all of these are
    still governed centrally by the Spring Boot BOM in <dependencyManagement> above.
  -->
  <dependencies>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.11.0</version>
        <configuration>
          <source>21</source>
          <target>21</target>
          <release>21</release>
          <parameters>true</parameters>
        </configuration>
      </plugin>

      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.0.0</version>
      </plugin>

      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <version>${spring-boot.version}</version>
        <configuration>
          <excludes>
            <exclude>
              <groupId>org.projectlombok</groupId>
              <artifactId>lombok</artifactId>
            </exclude>
          </excludes>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
