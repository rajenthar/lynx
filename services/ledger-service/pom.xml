<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.lynx</groupId>
    <artifactId>lynx-parent</artifactId>
    <version>0.1.0</version>
    <relativePath>../../pom.xml</relativePath>
  </parent>

  <artifactId>ledger-service</artifactId>
  <packaging>jar</packaging>

  <name>ledger-service</name>
  <description>Append-only double-entry ledger + transactional outbox; executes HOLD/LOCK/SETTLE/RELEASE saga phases (ADR-001/002/004)</description>

  <dependencies>
    <dependency>
      <groupId>com.lynx</groupId>
      <artifactId>lynx-common</artifactId>
      <version>0.1.0</version>
    </dependency>
    <dependency>
      <groupId>com.lynx</groupId>
      <artifactId>lynx-money</artifactId>
      <version>0.1.0</version>
    </dependency>
    <dependency>
      <groupId>com.lynx</groupId>
      <artifactId>lynx-security</artifactId>
      <version>0.1.0</version>
    </dependency>
    <dependency>
      <groupId>com.lynx</groupId>
      <artifactId>lynx-idempotency</artifactId>
      <version>0.1.0</version>
    </dependency>
    <dependency>
      <groupId>com.lynx</groupId>
      <artifactId>lynx-events</artifactId>
      <version>0.1.0</version>
    </dependency>
    <dependency>
      <groupId>com.lynx</groupId>
      <artifactId>lynx-telemetry</artifactId>
      <version>0.1.0</version>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-jpa</artifactId>
    </dependency>

    <!--
      Real OpenTelemetry traces/metrics, exported to the Phase 0.9 infra OTel
      Collector (OTLP HTTP, port 4318). actuator brings Micrometer itself;
      the tracing-bridge-otel + exporter-otlp pair sends spans; the
      micrometer-registry-otlp brings metrics. Versions all managed by the
      Spring Boot BOM already imported at the root.
    -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>
    <dependency>
      <groupId>io.micrometer</groupId>
      <artifactId>micrometer-tracing-bridge-otel</artifactId>
    </dependency>
    <dependency>
      <groupId>io.opentelemetry</groupId>
      <artifactId>opentelemetry-exporter-otlp</artifactId>
    </dependency>
    <dependency>
      <groupId>io.micrometer</groupId>
      <artifactId>micrometer-registry-otlp</artifactId>
    </dependency>
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-core</artifactId>
    </dependency>
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-database-postgresql</artifactId>
    </dependency>
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <scope>runtime</scope>
    </dependency>

    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>postgresql</artifactId>
      <scope>test</scope>
    </dependency>

    <!--
      Test-only: the JDK's default HttpURLConnection-based request factory
      throws HttpRetryException ("cannot retry due to server authentication,
      in streaming mode") when TestRestTemplate POSTs a body to an endpoint
      that returns 401 — a JDK quirk unrelated to ledger-service's own
      behavior. Apache HttpClient doesn't have this problem.
    -->
    <dependency>
      <groupId>org.apache.httpcomponents.client5</groupId>
      <artifactId>httpclient5</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.testcontainers</groupId>
        <artifactId>testcontainers-bom</artifactId>
        <version>1.20.1</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>
