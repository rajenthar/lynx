<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.lynx</groupId>
    <artifactId>lynx-parent</artifactId>
    <version>0.1.0</version>
    <relativePath>../../pom.xml</relativePath>
  </parent>

  <artifactId>account-service</artifactId>
  <packaging>jar</packaging>

  <name>account-service</name>
  <description>Owns account creation/funding and the CQRS balance projection (ADR-005), consuming ledger-service's outbox via Debezium/Kafka (other-docs/12) — the first real consumer of ADR-002's CDC pipeline</description>

  <properties>
    <!-- Explicit for clarity, even though it's already inherited from
         lynx-parent's own maven.compiler.release/source/target (root
         pom.xml) — makes this module's Java version visible without
         needing to open the parent. -->
    <maven.compiler.release>21</maven.compiler.release>
  </properties>

  <dependencies>
    <dependency>
      <groupId>com.lynx</groupId>
      <artifactId>lynx-common</artifactId>
      <version>0.1.0</version>
    </dependency>
    <dependency>
      <groupId>com.lynx</groupId>
      <artifactId>lynx-money</artifactId>
      <version>0.1.0</version>
    </dependency>
    <dependency>
      <groupId>com.lynx</groupId>
      <artifactId>lynx-security</artifactId>
      <version>0.1.0</version>
    </dependency>
    <dependency>
      <groupId>com.lynx</groupId>
      <artifactId>lynx-events</artifactId>
      <version>0.1.0</version>
    </dependency>
    <dependency>
      <groupId>com.lynx</groupId>
      <artifactId>lynx-telemetry</artifactId>
      <version>0.1.0</version>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-jpa</artifactId>
    </dependency>

    <!-- Backs @RequiresInternalService (other-docs/13) — a declarative
         alternative to a manual if-check, deliberately NOT Spring
         Security's @PreAuthorize: no other service in this project uses
         Spring Security, and adopting it here alone would introduce a
         real new framework dependency plus a SecurityContextHolder
         bridge just to replace a two-line role check. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-aop</artifactId>
    </dependency>

    <!-- The consuming side of ADR-002's CDC pipeline — Debezium's Postgres
         connector produces Debezium's own flat CDC JSON onto
         lynx.public.outbox (registered against ledger-service's outbox
         table, other-docs/12); this is spring-kafka's plain @KafkaListener
         reading that topic. Version managed by the Spring Boot BOM. -->
    <dependency>
      <groupId>org.springframework.kafka</groupId>
      <artifactId>spring-kafka</artifactId>
    </dependency>

    <dependency>
      <groupId>io.github.resilience4j</groupId>
      <artifactId>resilience4j-circuitbreaker</artifactId>
      <version>2.2.0</version>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>
    <dependency>
      <groupId>io.micrometer</groupId>
      <artifactId>micrometer-tracing-bridge-otel</artifactId>
    </dependency>
    <dependency>
      <groupId>io.opentelemetry</groupId>
      <artifactId>opentelemetry-exporter-otlp</artifactId>
    </dependency>
    <dependency>
      <groupId>io.micrometer</groupId>
      <artifactId>micrometer-registry-otlp</artifactId>
    </dependency>
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-core</artifactId>
    </dependency>
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-database-postgresql</artifactId>
    </dependency>
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <scope>runtime</scope>
    </dependency>

    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>postgresql</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.apache.httpcomponents.client5</groupId>
      <artifactId>httpclient5</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.testcontainers</groupId>
        <artifactId>testcontainers-bom</artifactId>
        <version>1.20.1</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>
