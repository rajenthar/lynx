<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.lynx</groupId>
    <artifactId>lynx-parent</artifactId>
    <version>0.1.0</version>
    <relativePath>../../pom.xml</relativePath>
  </parent>

  <artifactId>saga-orchestrator</artifactId>
  <packaging>jar</packaging>

  <name>saga-orchestrator</name>
  <description>Drives HOLD to LOCK to EXECUTE to SETTLE across ledger-service and fx-rate-service (ADR-003); polling loop with FOR UPDATE SKIP LOCKED, ADR-007 service-to-service auth as the caller</description>

  <dependencies>
    <dependency>
      <groupId>com.lynx</groupId>
      <artifactId>lynx-common</artifactId>
      <version>0.1.0</version>
    </dependency>
    <dependency>
      <groupId>com.lynx</groupId>
      <artifactId>lynx-money</artifactId>
      <version>0.1.0</version>
    </dependency>
    <dependency>
      <groupId>com.lynx</groupId>
      <artifactId>lynx-security</artifactId>
      <version>0.1.0</version>
    </dependency>
    <dependency>
      <groupId>com.lynx</groupId>
      <artifactId>lynx-telemetry</artifactId>
      <version>0.1.0</version>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-jpa</artifactId>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>

    <!-- Guards the actual downstream calls to ledger-service/fx-rate-service
         (AbstractServiceClient, other-docs/10 Decision 8) — one instance
         per client, each with ignoreExceptions(HttpClientErrorException)
         so a 4xx isn't a breaker failure but still throws normally.
         lynx-security also depends on this directly now, for
         ServiceTokenProvider's own internal breaker guarding the shared
         token fetch (a separate, independently-named instance) — this
         module's own direct dependency stays explicit since it builds
         CircuitBreakerConfig/CircuitBreaker itself in BeansConfig. -->
    <dependency>
      <groupId>io.github.resilience4j</groupId>
      <artifactId>resilience4j-circuitbreaker</artifactId>
      <version>2.2.0</version>
    </dependency>
    <dependency>
      <groupId>io.micrometer</groupId>
      <artifactId>micrometer-tracing-bridge-otel</artifactId>
    </dependency>
    <dependency>
      <groupId>io.opentelemetry</groupId>
      <artifactId>opentelemetry-exporter-otlp</artifactId>
    </dependency>
    <dependency>
      <groupId>io.micrometer</groupId>
      <artifactId>micrometer-registry-otlp</artifactId>
    </dependency>
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-core</artifactId>
    </dependency>
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-database-postgresql</artifactId>
    </dependency>
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <scope>runtime</scope>
    </dependency>

    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>postgresql</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.apache.httpcomponents.client5</groupId>
      <artifactId>httpclient5</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.testcontainers</groupId>
        <artifactId>testcontainers-bom</artifactId>
        <version>1.20.1</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>
